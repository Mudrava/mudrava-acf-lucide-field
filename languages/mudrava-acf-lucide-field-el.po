msgid "%d icons available"
msgstr "%d διαθέσιμα εικονίδια"

msgid "%s selected"
msgstr "%s επιλεγμένο"

msgid "Accepted format: SVG with an &lt;svg&gt; root and a viewBox. Maximum size: %s. Icons are available in the picker and shortcodes as custom:&lt;name&gt;."
msgstr "Αποδεκτή μορφή: SVG με ριζικό στοιχείο &lt;svg&gt; και viewBox. Μέγιστο μέγεθος: %s. Τα εικονίδια είναι διαθέσιμα στον επιλογέα και στα shortcode ως custom:&lt;name&gt;."

msgid "Actions"
msgstr "Ενέργειες"

msgid "Add icon"
msgstr "Προσθήκη εικονιδίου"

msgid "Allow Null"
msgstr "Επιτρέπεται κενή τιμή"

msgid "Allow the field to have no icon selected."
msgstr "Επιτρέπει στο πεδίο να μην έχει επιλεγμένο εικονίδιο."

msgid "Block saving with a validation error"
msgstr "Αποτροπή αποθήκευσης με σφάλμα επικύρωσης"

msgid "Clear selection"
msgstr "Καθαρισμός επιλογής"

msgid "Comma-separated terms that make the icon findable in the picker search."
msgstr "Όροι χωρισμένοι με κόμματα που κάνουν το εικονίδιο αναζητήσιμο στην αναζήτηση του επιλογέα."

msgid "Custom Icons"
msgstr "Προσαρμοσμένα εικονίδια"

msgid "Default Value"
msgstr "Προεπιλεγμένη τιμή"

msgid "Delete"
msgstr "Διαγραφή"

msgid "Delete this icon? Existing fields will fall back to their default behavior."
msgstr "Να διαγραφεί αυτό το εικονίδιο; Τα υπάρχοντα πεδία θα επιστρέψουν στην προεπιλεγμένη συμπεριφορά τους."

msgid "Docs"
msgstr "Τεκμηρίωση"

msgid "Enter the icon value to be selected by default (e.g., \"rocket\" or \"simple:facebook\")."
msgstr "Εισάγετε την τιμή του εικονιδίου που θα επιλέγεται προεπιλεγμένα (π.χ. \"rocket\" ή \"simple:facebook\")."

msgid "How to handle values that are not part of the bundled icon set (e.g. icons imported from another site or values left over after an icon library update)."
msgstr "Πώς να χειρίζεστε τιμές που δεν αποτελούν μέρος του παρεχόμενου συνόλου εικονιδίων (π.χ. εικονίδια που εισήχθησαν από άλλον ιστότοπο ή τιμές που απέμειναν μετά από ενημέρωση της βιβλιοθήκης εικονιδίων)."

msgid "Icon <strong>%s</strong> was added to the library."
msgstr "Το εικονίδιο <strong>%s</strong> προστέθηκε στη βιβλιοθήκη."

msgid "Icon <strong>%s</strong> was deleted."
msgstr "Το εικονίδιο <strong>%s</strong> διαγράφηκε."

msgid "Icon Value (e.g., \"rocket\" or \"simple:facebook\")"
msgstr "Τιμή εικονιδίου (π.χ. \"rocket\" ή \"simple:facebook\")"

msgid "Keywords"
msgstr "Λέξεις-κλειδιά"

msgid "Lucide Icon"
msgstr "Εικονίδιο Lucide"

msgid "Mudrava Icon Field — Custom Icons"
msgstr "Mudrava Icon Field — Προσαρμοσμένα εικονίδια"

msgid "Mudrava Icon Field:"
msgstr "Mudrava Icon Field:"

msgid "Mudrava Icon Field: an icon with that name already exists. Uploads never overwrite stored icons; delete the old icon first or use another name."
msgstr "Mudrava Icon Field: υπάρχει ήδη εικονίδιο με αυτό το όνομα. Οι μεταφορές αρχείων δεν αντικαθιστούν ποτέ αποθηκευμένα εικονίδια· διαγράψτε πρώτα το παλιό εικονίδιο ή χρησιμοποιήστε άλλο όνομα."

msgid "Mudrava Icon Field: some icon values are not part of the bundled icon set and will render as empty markup:"
msgstr "Mudrava Icon Field: ορισμένες τιμές εικονιδίων δεν αποτελούν μέρος του παρεχόμενου συνόλου και θα αποδοθούν ως κενή σήμανση:"

msgid "Mudrava Icon Field: that file is not a valid SVG document. Only plain shape elements (circle, ellipse, line, path, polygon, polyline, rect) inside an &lt;svg&gt; root are accepted."
msgstr "Mudrava Icon Field: το αρχείο δεν είναι έγκυρο έγγραφο SVG. Μέσα στη ρίζα &lt;svg&gt; γίνονται δεκτά μόνο απλά γεωμετρικά στοιχεία (circle, ellipse, line, path, polygon, polyline, rect)."

msgid "Mudrava Icon Field: that file is too large. The limit is %s."
msgstr "Mudrava Icon Field: το αρχείο είναι πολύ μεγάλο. Το όριο είναι %s."

msgid "Mudrava Icon Field: that icon no longer exists in the library."
msgstr "Mudrava Icon Field: αυτό το εικονίδιο δεν υπάρχει πλέον στη βιβλιοθήκη."

msgid "Mudrava Icon Field: the icon storage is not writable. Check filesystem permissions."
msgstr "Mudrava Icon Field: ο χώρος αποθήκευσης εικονιδίων δεν είναι εγγράψιμος. Ελέγξτε τα δικαιώματα του συστήματος αρχείων."

msgid "Name"
msgstr "Όνομα"

msgid "No custom icons yet."
msgstr "Δεν υπάρχουν ακόμα προσαρμοσμένα εικονίδια."

msgid "No icon selected"
msgstr "Δεν έχει επιλεγεί εικονίδιο"

msgid "No icons found"
msgstr "Δεν βρέθηκαν εικονίδια"

msgid "Optional; defaults to the file name"
msgstr "Προαιρετικό· προεπιλεγμένα χρησιμοποιείται το όνομα του αρχείου"

msgid "Placeholder"
msgstr "Ενδεικτικό κείμενο"

msgid "Placeholder text for the search input."
msgstr "Ενδεικτικό κείμενο για το πεδίο αναζήτησης."

msgid "Please select a valid icon."
msgstr "Επιλέξτε ένα έγκυρο εικονίδιο."

msgid "Please select an icon."
msgstr "Επιλέξτε ένα εικονίδιο."

msgid "Preview"
msgstr "Προεπισκόπηση"

msgid "Return Format"
msgstr "Μορφή επιστρεφόμενης τιμής"

msgid "SVG Markup"
msgstr "Σήμανση SVG"

msgid "SVG file"
msgstr "Αρχείο SVG"

msgid "Save and show an admin notice (default)"
msgstr "Αποθήκευση και εμφάνιση ειδοποίησης στον πίνακα ελέγχου (προεπιλογή)"

msgid "Search icons or brand logos..."
msgstr "Αναζήτηση εικονιδίων ή λογότυπων επωνυμιών..."

msgid "Search keywords"
msgstr "Λέξεις-κλειδιά αναζήτησης"

msgid "Select an icon"
msgstr "Επιλογή εικονιδίου"

msgid "Specify the format returned by get_field()."
msgstr "Καθορίστε τη μορφή που επιστρέφει η get_field()."

msgid "Stored icon is not in the bundled icon set"
msgstr "Το αποθηκευμένο εικονίδιο δεν βρίσκεται στο παρεχόμενο σύνολο εικονιδίων"

msgid "Stored icons"
msgstr "Αποθηκευμένα εικονίδια"

msgid "The icon file could not be written."
msgstr "Δεν ήταν δυνατή η εγγραφή του αρχείου εικονιδίου."

msgid "The icon storage directory could not be created."
msgstr "Δεν ήταν δυνατή η δημιουργία του καταλόγου αποθήκευσης εικονιδίων."

msgid "The icon storage is not writable on this site."
msgstr "Ο χώρος αποθήκευσης εικονιδίων δεν είναι εγγράψιμος σε αυτόν τον ιστότοπο."

msgid "The storage name is derived from this title: lowercase, dashes, max 64 characters."
msgstr "Το όνομα αποθήκευσης προκύπτει από αυτόν τον τίτλο: πεζοί χαρακτήρες, παύλες, έως 64 χαρακτήρες."

msgid "This plugin requires %1$s version %2$s or higher to function."
msgstr "Το πρόσθετο απαιτεί %1$s έκδοση %2$s ή νεότερη για να λειτουργεί."

msgid "Title"
msgstr "Τίτλος"

msgid "Unknown Icon Values"
msgstr "Άγνωστες τιμές εικονιδίων"

msgid "Upload plain SVG icons to extend the picker with a custom set. Files are sanitized on upload: scripts, styles, embedded images and unsupported elements are removed, and only the allowlisted shape markup is stored."
msgstr "Μεταφορτώστε απλά εικονίδια SVG για να επεκτείνετε τον επιλογέα με ένα δικό σας σύνολο. Τα αρχεία καθαρίζονται κατά τη μεταφόρτωση: script, στυλ, ενσωματωμένες εικόνες και μη υποστηριζόμενα στοιχεία αφαιρούνται και αποθηκεύεται μόνο η επιτρεπόμενη σήμανση γεωμετρικών σχημάτων."

msgid "Value"
msgstr "Τιμή"

msgid "You are not allowed to manage custom icons."
msgstr "Δεν έχετε δικαίωμα διαχείρισης προσαρμοσμένων εικονιδίων."

msgid "logo, company, brand"
msgstr "λογότυπο, εταιρεία, επωνυμία"
